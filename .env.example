# ── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Seule cette adresse peut se connecter au dashboard.
ALLOWED_EMAIL=ton.adresse@gmail.com
# 32 octets en base64 : `openssl rand -base64 32`
ENCRYPTION_KEY=

# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google (Gmail) ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── IA ────────────────────────────────────────────────
# anthropic | openai
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── La bonne alternance ───────────────────────────────
# Clé à créer sur https://api.apprentissage.beta.gouv.fr/fr/compte/profil
LBA_API_KEY=
LBA_API_BASE=https://api.apprentissage.beta.gouv.fr/api
# Candidature via l'API LBA : nécessite l'habilitation applications:write.
# Laisse à false tant que l'habilitation n'est pas accordée.
LBA_APPLY_ENABLED=false
LBA_APPLY_BASE=

# ── Inngest (renseignés automatiquement par l'intégration Vercel) ──
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
